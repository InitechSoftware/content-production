# TimelinesAI Public API bearer tokens.
# Get from app.timelines.ai → Integrations → Public API → Copy.
# Permanent (don't expire); regenerating invalidates the old one immediately.

# Primary workspace (owner phone e.g. +1 555 0100) — multi-account, includes
# several personal accounts under the same workspace. Used for read/discovery.
TLA_TOKEN_SUPPORT=

# Secondary single-account workspace (owner phone e.g. +1 555 0200) —
# safe for write tests since you own it.
TLA_TOKEN_TIMELINES15=
